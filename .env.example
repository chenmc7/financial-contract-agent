# Copy this file to .env. Never commit the real .env file.
CONTRACTGUARD_API_KEY=
CONTRACTGUARD_PROVIDER=openai
CONTRACTGUARD_MODEL=gpt-4o-mini
CONTRACTGUARD_BASE_URL=https://api.openai.com/v1
# Optional, for example: http://127.0.0.1:7897
CONTRACTGUARD_PROXY=

# Usually no change is needed below.
CONTRACTGUARD_PORT=8899

# 公网只读保护令牌（可选）。SHARE_MODE（share.sh 启动的公网实例）下所有写请求会被拦截；
# 配置本项后，在请求头 X-Share-Token 中携带同一串即可临时放行写操作（维护者远程使用）。
CONTRACTGUARD_SHARE_TOKEN=
